# Turso (required)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Provider keys (configure in Vercel or add through the protected dashboard)
KIE_API_KEY=
COMETAPI_API_KEY=
POLLINATIONS_KEY=
MAGIC_HOUR_API_KEY=

# External video merger service v2 base URL and shared API token

# Endpoint protection. ADMIN_API_TOKEN may be set separately;
# if omitted, MCP_AUTH_TOKEN also protects dashboard administration.
MCP_AUTH_TOKEN=
ADMIN_API_TOKEN=
API_KEY_ENCRYPTION_SECRET=

# Provider/model configuration
IMAGE_MODEL=gpt-image-2-6/flare-text-to-image
VIDEO_MODEL=grok-imagine-video-1-5-preview
COMET_IMAGE_MODEL=gpt-image-2.6-flare
COMET_VIDEO_MODEL=grok-imagine-video-1.5
POLLINATIONS_IMAGE_MODEL=black-forest-labs/flux.1-schnell
POLLINATIONS_VIDEO_MODEL=google/veo-3.1-fast
KIE_BASE_URL=https://api.kie.ai
COMETAPI_BASE_URL=https://api.cometapi.com

# Video merge limits
MAX_SOURCES=10
SOURCE_MAX_MB=200
OUTPUT_MAX_MB=150
MAX_TOTAL_DURATION_SEC=600
FFMPEG_PRESET=medium
CRON_SECRET=
